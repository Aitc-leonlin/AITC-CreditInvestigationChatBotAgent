# Database mode: sqlite or postgresql
DATABASE_MODE=sqlite

# Local SQLite mode
SQLITE_DB_PATH=FinancialStatementXBRL.db

# External PostgreSQL mode (required when DATABASE_MODE=postgresql)
# You may use one Render-style URL instead of the five DATABASE_HOST/... values:
# DATABASE_URL=postgresql://aitc_app:replace-with-a-secret@your-database.example.com:5432/aitc_credit_investigation
DATABASE_HOST=your-database.example.com
DATABASE_PORT=5432
DATABASE_NAME=aitc_credit_investigation
DATABASE_USER=aitc_app
DATABASE_PASSWORD=replace-with-a-secret
DATABASE_SSLMODE=require
# Required only when DATABASE_SSLMODE=verify-ca or verify-full
DATABASE_SSLROOTCERT=
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_APPLICATION_NAME=aitc-credit-investigation-backend
DATABASE_SCHEMA=public

# Authentication secrets
MEMBERSHIP_JWT_SECRET=replace-with-a-long-random-secret

# Deployment and CORS
IS_RENDER_DEPLOY=FALSE
CORS_ALLOW_ORIGINS=http://localhost:3000,https://aitc-creditinvestigationchatbotwebui.onrender.com

# LLM provider
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL_NAME=gpt-5.4-mini

# LangSmith observability (disabled by default to avoid exporting sensitive data)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=aitc-credit-investigation-backend
# Required only when the API key can access multiple LangSmith workspaces
LANGSMITH_WORKSPACE_ID=
# Keep the default for LangSmith US cloud; use https://eu.api.smith.langchain.com for EU
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
